meta {
  name: Resume repair
  type: http
  seq: 15
}

post {
  url: {{base_url}}/work-orders/{{order_id}}/resume
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{technician_token}}
  Idempotency-Key: {{run_id}}-resume
}

body:json {
  {
    "expected_version": {{version}},
    "note": "Replacement arrived."
  }
}

script:post-response {
  bru.setVar("version", res.getBody().version);
}

tests {
  test("Resume repair", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("IN_PROGRESS");
  });
}
