meta {
  name: Report a fault
  type: http
  seq: 6
}

post {
  url: {{base_url}}/fault-reports
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{run_id}}-fault
}

body:json {
  {
    "asset_id": "{{asset_id}}",
    "title": "Process pump stopped",
    "symptoms": "The pump stopped after unusual vibration.",
    "observed_at": "{{observed_at}}",
    "suggested_priority": "HIGH"
  }
}

script:post-response {
  bru.setVar("report_id", res.getBody().id);
  bru.setVar("version", res.getBody().version);
}

tests {
  test("Report a fault", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
