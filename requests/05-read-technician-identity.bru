meta {
  name: Read technician identity
  type: http
  seq: 5
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{technician_token}}
}

script:post-response {
  bru.setVar("technician_id", res.getBody().id);
}

tests {
  test("Read technician identity", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
