meta {
  name: Convert fault to work order
  type: http
  seq: 9
}

post {
  url: {{base_url}}/fault-reports/{{report_id}}/work-order
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{supervisor_token}}
  Idempotency-Key: {{run_id}}-convert
}

body:json {
  {
    "expected_version": {{version}},
    "priority": "HIGH",
    "review_notes": "Inspect the fictional pump."
  }
}

script:post-response {
  bru.setVar("order_id", res.getBody().id);
  bru.setVar("version", res.getBody().version);
}

tests {
  test("Convert fault to work order", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
