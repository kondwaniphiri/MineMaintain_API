# Native PostgreSQL development. Create this database and role locally.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=minemaintain
DB_USER=minemaintain
DB_PASSWORD=

# Optional full URL takes priority over DB_* settings for the API and Alembic.
# DATABASE_URL=postgresql+psycopg://minemaintain:replace-me@127.0.0.1:5432/minemaintain

# Docker Compose only. Compose configures the API container to use its database.
POSTGRES_PASSWORD=

# Use a separate, empty PostgreSQL database for tests.
TEST_DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=minemaintain-api
JWT_AUDIENCE=minemaintain-client
ACCESS_TOKEN_MINUTES=15
ENVIRONMENT=local
